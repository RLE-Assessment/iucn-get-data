  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Mostly in semi-arid regions of Africa, southern Australia, Eurasia, and western parts of North and South America."
  }, {
    "@language" : "es",
    "@value" : "Principalmente en regiones semiáridas de África, sur de Australia, Eurasia y partes occidentales de América del Norte y del Sur."
  }, {
    "@language" : "fr",
    "@value" : "Principalement dans les régions semi-arides d\\'Afrique, d\\'Australie\nméridionale, d\\'Eurasie et dans les parties occidentales de l\\'Amérique\ndu Nord et du Sud."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Permanent salt and soda lakes"
  } ],
  "http://www.w3.org/2004/02/skos/core#related" : [ {
