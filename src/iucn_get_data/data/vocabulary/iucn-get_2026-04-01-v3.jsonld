}, {
  "@id" : "https://w3id.org/iucn-get/Realm_S",
  "@type" : [ "http://www.w3.org/2000/01/rdf-schema#Resource", "https://w3id.org/iucn-get/ontology#Realm", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://purl.org/dc/terms/identifier" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "https://w3id.org/iucn-get/Realm_S"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The Subterranean realm includes the earth’s crust and subsurface voids characterised by an absence or very low intensity of sunlight.\n\nEnergy is therefore a major resource driver in these ecosystems, although other resources such as water and carbon, may sometimes be limiting. The ambient environment is relatively stable, although extreme temperatures occur in local areas influenced by vulcanism and substrate type influences availability of nutrients and seepage of moisture. Disturbances are rare and limited to mass movement or subterranean fires restricted to coal, oil or gas strata, with combustion rates limited by oxygen. Subterranean trophic webs are truncated, lacking photoautotrophs, herbivores and large predators. The microbial biota is a key feature in the expression of different subterranean ecosystems."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/iucn-get/IUCNEcosystemTypology"
  } ],
  "http://www.w3.org/2004/02/skos/core#narrower" : [ {
    "@id" : "https://w3id.org/iucn-get/Biome_S2"
  }, {
    "@id" : "https://w3id.org/iucn-get/Biome_S1"
  } ],
  "http://www.w3.org/2004/02/skos/core#narrowerTransitive" : [ {
    "@id" : "https://w3id.org/iucn-get/EFG_S2_1"
  }, {
    "@id" : "https://w3id.org/iucn-get/EFG_S1_1"
  }, {
    "@id" : "https://w3id.org/iucn-get/EFG_S1_2"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "S"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Subterranean"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/iucn-get/IUCNEcosystemTypology"
  } ],
