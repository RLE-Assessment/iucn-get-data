}, {
  "@id" : "https://w3id.org/iucn-get/Realm_A",
  "@type" : [ "http://www.w3.org/2000/01/rdf-schema#Resource", "https://w3id.org/iucn-get/ontology#Realm", "http://www.w3.org/2004/02/skos/core#Concept" ],
