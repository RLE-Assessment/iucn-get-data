    "@value" : "core"
  } ]
}, {
  "@id" : "https://w3id.org/iucn-get/Realm_SF",
  "@type" : [ "http://www.w3.org/2000/01/rdf-schema#Resource", "https://w3id.org/iucn-get/ontology#Realm", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://purl.org/dc/terms/identifier" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "https://w3id.org/iucn-get/Realm_SF"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Unique ecosystems also occur where the subterranean realm meets the interface of the freshwater realms."
  } ],
