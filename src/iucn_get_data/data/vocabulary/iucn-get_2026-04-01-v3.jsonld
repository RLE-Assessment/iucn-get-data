  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The interface of marine and terrestrial ecosystems is sometimes influenced by seepage or outflow of freshwater, supporting intertidal wetlands and deltaic systems."
  } ],
