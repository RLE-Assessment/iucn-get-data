  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Code assigned to a Biome in the IUCN Global Ecosystem Typology."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/iucn-get/ontology#Biome"
  } ],
