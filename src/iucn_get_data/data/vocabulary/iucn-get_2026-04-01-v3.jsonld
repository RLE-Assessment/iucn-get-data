}, {
  "@id" : "https://w3id.org/iucn-get/Realm_MT",
  "@type" : [ "http://www.w3.org/2000/01/rdf-schema#Resource", "https://w3id.org/iucn-get/ontology#Realm", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://purl.org/dc/terms/identifier" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI",
    "@value" : "https://w3id.org/iucn-get/Realm_MT"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The marine-terrestrial transitional realm is characterised by steep environmental gradients in desiccation, salinity and wave and tide disturbance, occupied by contrasting shoreline ecosystems."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/iucn-get/IUCNEcosystemTypology"
  } ],
