  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Unique ecosystems also occur where the subterranean realm meets the interface of the marine realms."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
