  "https://w3id.org/iucn-get/ontology#languageVersion" : [ {
    "@id" : "_:node1jn8oqbrdx87"
  }, {
    "@id" : "_:node1jn8oqbrdx88"
  }, {
    "@id" : "_:genid-9622f053ce2f46ba83bb5d06a3bfdca4-54AF29BB77D4E95632A9C443353282E8"
  }, {
