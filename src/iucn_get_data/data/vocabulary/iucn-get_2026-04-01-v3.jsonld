    "@value" : "M3.7"
  } ],
  "https://w3id.org/iucn-get/ontology#keyFeatures" : [ {
    "@language" : "en",
    "@value" : "Systems supported by microbial chemoautotrophy with high biomass of relatively low diversity, highly speciliased, fauna"
  } ],
