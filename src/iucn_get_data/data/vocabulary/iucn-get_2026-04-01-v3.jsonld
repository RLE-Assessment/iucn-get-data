    "@value" : "S1"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Subterranean lithic biome"
  }, {
    "@language" : "es",
    "@value" : "Bioma lítico subterráneo"
  }, {
    "@language" : "fr",
    "@value" : "Biome lithique souterrain"
  } ],
  "https://w3id.org/iucn-get/ontology#biomeCode" : [ {
    "@value" : "S1"
  } ],
  "https://w3id.org/iucn-get/ontology#languageVersion" : [ {
    "@id" : "_:node1jn8oqbrdx21"
  }, {
