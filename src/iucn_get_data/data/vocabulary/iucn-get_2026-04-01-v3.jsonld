}, {
  "@id" : "https://w3id.org/iucn-get/ontology#Biome",
  "@type" : [ "http://www.w3.org/2000/01/rdf-schema#Resource", "http://www.w3.org/2000/01/rdf-schema#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://global-ecosystems.org/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A component of a realm united by broad features of ecosystem structure and one or a few common major ecological drivers that regulate major ecological functions, derived from the top-down by subdivision of realms (level 1)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Functional biome"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2000/01/rdf-schema#Resource"
  }, {
    "@id" : "https://w3id.org/iucn-get/ontology#Biome"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "In GET, biome is different from the use of biome in other contexts — it is defined functionally rather than by vegetation physiognomy or climate alone."
  } ]
}, {
  "@id" : "https://w3id.org/iucn-get/ontology#EcosystemFunctionalGroup",
  "@type" : [ "http://www.w3.org/2000/01/rdf-schema#Resource", "http://www.w3.org/2000/01/rdf-schema#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://global-ecosystems.org/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A group of related ecosystems within a biome that share common ecological drivers, which in turn promote similar biotic traits that characterise the group. Derived from the top-down by subdivision of biomes."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Ecosystem Functional Group"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2000/01/rdf-schema#Resource"
  }, {
    "@id" : "https://w3id.org/iucn-get/ontology#EcosystemFunctionalGroup"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "EFG"
  } ]
}, {
  "@id" : "https://w3id.org/iucn-get/ontology#Realm",
  "@type" : [ "http://www.w3.org/2000/01/rdf-schema#Resource", "http://www.w3.org/2000/01/rdf-schema#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://global-ecosystems.org/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "One of five major components of the biosphere that differ fundamentally in ecosystem organisation and function: terrestrial, freshwater, marine, subterranean, atmospheric and combinations of these (transitional realms). Because variation in nature is continuous, we also include transitional realms, where the realms meet and have their own unique organisation and function."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Realm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2000/01/rdf-schema#Resource"
  }, {
    "@id" : "https://w3id.org/iucn-get/ontology#Realm"
  } ]
}, {
