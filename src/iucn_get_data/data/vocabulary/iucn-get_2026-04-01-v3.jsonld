  }, {
    "@id" : "_:node1jn8oqbrdx155"
  }, {
    "@id" : "_:node1jn8oqbrdx156"
  } ],
  "https://w3id.org/iucn-get/ontology#latestModificationLanguage" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#language",
    "@value" : "es"
  } ],
  "https://w3id.org/iucn-get/ontology#latestUpdate" : [ {
    "@id" : "_:genid-9622f053ce2f46ba83bb5d06a3bfdca4-B1199F4C415E6AB339DCFC61BE1231E8"
  } ]
}, {
  "@id" : "https://w3id.org/iucn-get/EFG_M2_3",
